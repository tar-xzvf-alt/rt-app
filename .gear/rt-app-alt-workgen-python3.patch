+def unique_keys(pairs, verbose):
+    # Reserve existing names so a generated suffix cannot rename a real key.
+    reserved = {key for key, _ in pairs}
+    result = {}
+    next_suffix = {}
+    for key, value in pairs:
+        if key in result:
+            suffix = next_suffix.get(key, 1)
+            while f"{key}{suffix}" in reserved:
+                suffix += 1
+            new_key = f"{key}{suffix}"
+            next_suffix[key] = suffix + 1
+            reserved.add(new_key)
