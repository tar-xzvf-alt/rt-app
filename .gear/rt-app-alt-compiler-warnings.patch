Subject: [PATCH] Clean up compiler warnings without changing the workload

Keep the math calls, explicitly discarding their unused results.  The
scheduler helper does not return a value and its callers do not expect one.
Preserve the optional foreach index while marking it unused where needed.

--- a/src/rt-app.c
+++ b/src/rt-app.c
@@ -217,17 +217,17 @@
  */
 void waste_cpu_cycles(unsigned long long load_loops)
 {
-	double param, result;
+	double param;
 	double n;
 	unsigned long long i;
 
 	param = 0.95;
 	n = 4;
 	for (i = 0 ; i < load_loops ; i++) {
-		result = ldexp(param , (ldexp(param , ldexp(param , n))));
-		result = ldexp(param , (ldexp(param , ldexp(param , n))));
-		result = ldexp(param , (ldexp(param , ldexp(param , n))));
-		result = ldexp(param , (ldexp(param , ldexp(param , n))));
+		(void)ldexp(param , (ldexp(param , ldexp(param , n))));
+		(void)ldexp(param , (ldexp(param , ldexp(param , n))));
+		(void)ldexp(param , (ldexp(param , ldexp(param , n))));
+		(void)ldexp(param , (ldexp(param , ldexp(param , n))));
 	}
 	return;
 }
